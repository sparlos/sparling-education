{
  "name": "edtech-startup",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "generate": "turbo run generate",
    "lint": "turbo run format-and-lint",
    "lint:fix": "turbo run format-and-lint:fix",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "check-types": "turbo run check-types",
    "test": "turbo run test check-voice",
    "check-voice": "turbo run check-voice",
    "clear-students": "pnpm --filter @repo/db clear-students",
    "voice": "pnpm --filter @repo/voice voice",
    "voice:test": "pnpm --filter @repo/voice voice:test",
    "new-game": "node packages/game-kit/scripts/new-game.ts",
    "tour": "node packages/game-kit/scripts/tour.ts",
    "mutate": "node packages/game-kit/scripts/mutate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "^2.11.9",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
