{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "dev": "docker compose up --detach --wait && prisma migrate deploy",
    "stop": "docker compose stop",
    "migrate": "prisma migrate dev",
    "clear-students": "node scripts/clear-students.ts",
    "generate": "prisma generate",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "typescript": "7.0.2"
  }
}
