// Kindling's schema. This is the only place schema changes are made:
// edit this file, then run `pnpm --filter @repo/db migrate` to add a migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Who someone is to Kindling. Fixed when their account is made, by where they
// first signed in: the teacher app makes a teacher, a class or game link a student.
enum Role {
  teacher
  student
}

// One Google account. Kindling keeps only Google's opaque subject ID, the
// first name and the last initial: never the email, the full surname or a photo.
model Account {
  id            String       @id @default(uuid()) @db.Uuid
  googleSubject String       @unique
  role          Role
  firstName     String
  lastInitial   String
  createdAt     DateTime     @default(now())
  // A student's avatar look: item IDs per slot, as `parseLook` in
  // @repo/avatar reads them. Null until they design their avatar; always
  // null for a teacher.
  look          Json?
  sessions      Session[]
  // A teacher's classes.
  classes       Class[]
  // A student's classes.
  memberships   Membership[]
  // A student's plays, as the play shell sent them.
  playRecords   PlayRecord[]
  // A student's rewards.
  rewards       Reward[]
}

// A signed-in browser. The cookie holds a random token; only its hash is kept.
model Session {
  tokenHash String   @id
  accountId String   @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([accountId])
}

// A teacher's class. Students join it with its join code, which the class join
// link and every game link carry.
model Class {
  id          String       @id @default(uuid()) @db.Uuid
  teacherId   String       @db.Uuid
  teacher     Account      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name        String
  // One or more of Grades 3–5, ascending.
  grades      Int[]
  joinCode    String       @unique
  // The slugs of hosted games the teacher turned off. Every other hosted game
  // is on, so a game Kindling starts hosting is on in every class.
  gamesOff    String[]     @default([])
  createdAt   DateTime     @default(now())
  memberships Membership[]
  playRecords PlayRecord[]

  @@index([teacherId])
}

// A student in a class, and their grade in it, which chooses their tier in
// the class's games. Set on joining a single-grade class; in a split class
// it's null until the student picks one of the class's grades.
model Membership {
  studentId String   @db.Uuid
  student   Account  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String   @db.Uuid
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  grade     Int?
  joinedAt  DateTime @default(now())

  @@id([studentId, classId])
  @@index([classId])
}

enum PlayRecordKind {
  attempt
  end
}

enum Assistance {
  hint
  demonstration
  guided
}

enum PlayEnding {
  finished
  left
  crashed
}

// One record of one play, stored as the play shell sent it: an attempt at a
// task, or how the play ended. Results are computed from these when they're
// read (the API's scoring module), so the rules can change without touching
// what's stored. A record keeps its game version, tier and expectation
// (edition included), so old evidence stays accurate.
model PlayRecord {
  studentId     String          @db.Uuid
  student       Account         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // Made by the shell; with the student, the idempotency key.
  id            String
  // The class the play was opened for; its results go there.
  classId       String          @db.Uuid
  class         Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  play          String
  game          String
  gameVersion   Int
  tier          String
  // When it happened, by the device's clock. Records can arrive days late.
  at            DateTime
  kind          PlayRecordKind
  // An attempt's fields.
  task          String?
  expectation   String?
  succeeded     Boolean?
  misconception String?
  assisted      Assistance?
  // For teachers, as the game wrote them: what the task asked, and what the
  // student did on this try. Plain text; never scored.
  asked         String?
  detail        String?
  // A try that only explored: shown to teachers, never scored.
  exploring     Boolean         @default(false)
  // An end's.
  ending        PlayEnding?
  // Arrival order, which within a play is the order the shell made them in.
  sequence      Int             @default(autoincrement())
  receivedAt    DateTime        @default(now())

  @@id([studentId, id])
  @@index([classId])
  @@index([studentId, play])
  // Covers the dashboard's grouping of a class's records by what choosing
  // the plays scoring counts depends on (`choosingFields` in the API's
  // scoring module), so it reads only the index.
  @@index([classId, studentId, play, game, gameVersion, tier, kind, expectation, exploring, ending, at, sequence], map: "PlayRecord_choosing_idx")
}

// A reward granted to a student for effort: an outfit piece or a sticker,
// from @repo/rewards' catalogue. Granted when a play ends, up to a weekly cap
// (the API's scoring module), and kept once granted, whatever arrives later.
model Reward {
  studentId String    @db.Uuid
  student   Account   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // A reward ID from the catalogue.
  item      String
  // The play whose end granted it.
  play      String
  // The Monday of the week it counts toward the cap in, in school time.
  week      DateTime  @db.Date
  grantedAt DateTime  @default(now())
  // When the student saw it revealed in their locker; null while it's new.
  seenAt    DateTime?

  @@id([studentId, item])
  @@index([studentId, week])
}
