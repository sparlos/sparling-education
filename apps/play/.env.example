# Copy to .env.local (gitignored); Vite loads it.

# The same Google OAuth client ID as apps/api's GOOGLE_CLIENT_ID. Not a secret:
# Google's sign-in button sends it to the browser.
VITE_GOOGLE_CLIENT_ID=

# "stand-in" runs the shell on the stand-ins, without the API or Google: a
# pretend sign-in, and classes and play records kept in this browser.
# VITE_PLAY_PLATFORM=stand-in
