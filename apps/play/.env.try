# The try site's settings, for `--mode try`. A build also reads these from the
# environment, and from .env.try.local.

# Its address. Change it when the product has its real name.
VITE_TRY_SITE_URL=https://tryplaceholder.sparlingeducation.ca

# Whether search engines may list it. Hidden until launch: set this to true then.
VITE_TRY_INDEXABLE=false

# The marketing site, for the "Learn more" link. Without it, the link is left out.
# VITE_PRODUCT_SITE_URL=
