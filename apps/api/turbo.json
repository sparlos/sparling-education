{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "dependsOn": ["$TURBO_EXTENDS$", "@repo/db#dev"],
      "env": ["DATABASE_URL", "GOOGLE_CLIENT_ID", "PORT"]
    },
    "test": {
      "passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*"]
    }
  }
}
