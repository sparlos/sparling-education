# Copy to .env.local (gitignored); `pnpm dev` loads it.

# Kindling's Google OAuth client ID (Google Cloud console → Credentials).
# Not a secret. Without it, every sign-in is rejected.
GOOGLE_CLIENT_ID=

# Optional. Defaults to the Docker database `pnpm dev` starts on port 55432.
# DATABASE_URL=postgresql://kindling:kindling@localhost:55432/kindling

# Optional. Defaults to 3002; apps/teach proxies /api here.
# PORT=3002
